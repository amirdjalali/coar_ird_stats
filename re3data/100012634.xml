		<r3d:repositoryName language="eng">KRISHI - Knowledge based Resources Information Systems Hub for Innovations in Agriculture</r3d:repositoryName>
				<r3d:additionalName language="eng">Agricultural Data Repository in India</r3d:additionalName>
